#!/bin/bash
# Pre-commit hook: run cargo fmt + clippy on staged .rs files

set -e

# Only run if Rust files are staged
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -z "$STAGED_RS" ]; then
  exit 0
fi

echo "pre-commit: Rust files changed, running checks..."

# Check formatting
if ! cargo fmt --all -- --check 2>/dev/null; then
  echo ""
  echo "❌ cargo fmt failed. Files were auto-fixed."
  echo "   Run: cargo fmt --all"
  echo "   Then: git add -u && git commit"
  echo ""
  # Auto-fix formatting
  cargo fmt --all
  exit 1
fi

# Check clippy
if ! cargo clippy --all-targets -- -D warnings 2>/dev/null; then
  echo ""
  echo "❌ cargo clippy found issues. Please fix them before committing."
  echo ""
  exit 1
fi

echo "✅ pre-commit checks passed"
