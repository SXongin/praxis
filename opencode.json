{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "ensure-newline": {
      "command": ["/root/.config/opencode/ensure-trailing-newline.sh", "$FILE"],
      "extensions": [".rs", ".md", ".toml", ".json", ".yaml", ".yml", ".txt", ".sh", ".py", ".ts", ".js", ".css", ".html", ".xml", ".gitignore", ".dockerignore", ".env"]
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git push*": "ask",
      "gh *": "allow",
      "cargo *": "allow",
      "grep *": "allow"
    }
  }
}
